{
  "name": "agentpack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-agent package manager for MCP servers and plugins",
  "scripts": {
    "check": "node electron/core/selfcheck.ts",
    "cli": "node electron/core/cli.ts",
    "spike": "node spike/poc.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && node -e \"process.env.AGENTPACK_SMOKE=1;require('child_process').spawnSync(require('electron'),['out/main/main.js'],{stdio:'inherit',env:process.env})\"",
    "rehearse": "node electron/core/rehearse.ts",
    "prewarm": "node electron/core/cli.ts prewarm"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "main": "out/main/main.js"
}
