{
  "name": "agentpack",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-agent package manager for MCP servers and plugins",
  "scripts": {
    "check": "node electron/core/selfcheck.ts",
    "cli": "node electron/core/cli.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && node -e \"process.env.AGENTPACK_SMOKE=1;const r=require('child_process').spawnSync(require('electron'),['out/main/main.js','--demo'],{stdio:'inherit',env:process.env});process.exit(r.status===null?1:r.status)\"",
    "rehearse": "node electron/core/rehearse.ts",
    "prewarm": "node electron/core/cli.ts prewarm",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win",
    "e2e": "node electron/core/e2e.ts",
    "test": "node --test electron/core/detection/project.test.ts electron/core/hardening.test.ts electron/core/installer/process.test.ts electron/core/clm-regression.test.ts",
    "demo": "electron-vite build && electron out/main/main.js --demo",
    "test:ui": "node scripts/electron-e2e.mjs",
    "test:tools": "node scripts/tool-calls.mjs"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "main": "out/main/main.js",
  "author": "AgentPack — HackBattle, IEEE CS VIT Vellore",
  "build": {
    "appId": "dev.agentpack.app",
    "productName": "AgentPack",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "registry",
        "to": "registry"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "AgentPack-${version}-win-x64.exe"
    },
    "forceCodeSigning": false,
    "artifactName": "AgentPack-${version}-${os}-${arch}.${ext}"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
