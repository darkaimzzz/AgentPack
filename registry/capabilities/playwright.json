{
  "id": "playwright",
  "name": "Playwright",
  "type": "mcp",
  "description": "Drive a real browser: navigate, click, fill forms, screenshot, read console and network.",
  "source": "Microsoft — npm @playwright/mcp",
  "install": {
    "command": "npx",
    "args": [
      "-y",
      "@playwright/mcp@0.0.80",
      "--headless"
    ]
  },
  "supportedAgents": [
    "claude",
    "codex",
    "opencode"
  ],
  "triggers": [
    {
      "type": "file_glob",
      "pattern": "**/*.spec.ts"
    },
    {
      "type": "file_glob",
      "pattern": "**/*.spec.js"
    },
    {
      "type": "file_glob",
      "pattern": "**/*.test.ts"
    },
    {
      "type": "file_glob",
      "pattern": "**/e2e/**"
    }
  ]
}
